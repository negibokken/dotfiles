# Resolve symlinks so this configuration can also be used from a worktree.
typeset _zsh_config_root=${${(%):-%x}:A:h}

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8
export DOTFILES=$HOME/dotfiles
export SECOND_BRAIN=$HOME/Documents/obsidian/notes
export GOPATH=$HOME/go
export MYGO=$GOPATH/src/github.com/negibokken
export DENO_INSTALL=$HOME/.deno
export PNPM_HOME=$HOME/Library/pnpm
export EDITOR=nvim
export VISUAL=nvim

# Remove obsolete entries inherited from an older shell or tmux server.
typeset -gU path
for _zsh_old_path in \
  "$HOME/.rbenv/shims" "$HOME/.pyenv/shims" "$HOME/.nodebrew/current/bin" \
  "$HOME/.go/bin" /usr/local/opt/go/libexec/bin /usr/local/opt/bison/bin \
  "$HOME/Library/Android/sdk/platform-tools" \
  "$HOME/go/src/chromium.googlesource.com/chromium/tools/depot_tools" \
  "$PNPM_HOME/bin"; do
  path=("${(@)path:#$_zsh_old_path}")
done
unset _zsh_old_path

# These values may also have been inherited from the old configuration.
if [[ -n $GOROOT && ! -d $GOROOT ]]; then
  path=("${(@)path:#$GOROOT/bin}")
  unset GOROOT
fi
[[ -n $JAVA_HOME && ! -d $JAVA_HOME ]] && unset JAVA_HOME
[[ -n $PLANTUML_JAR && ! -f $PLANTUML_JAR ]] && unset PLANTUML_JAR
[[ -n $GRAPHVIZ_DOT && ! -x $GRAPHVIZ_DOT ]] && unset GRAPHVIZ_DOT

path=(
  "$HOME/.local/bin"
  "$HOME/.local/share/mise/shims"
  "$DOTFILES/bin"
  "$HOME/.rd/bin"
  "$DENO_INSTALL/bin"
  "$HOME/.poetry/bin"
  /opt/homebrew/bin /opt/homebrew/sbin
  "$PWD/.btools" "$PWD/btools"
  "$HOME/.cargo/bin" "$GOPATH/bin" "$PNPM_HOME" "$HOME/.bin"
  "$HOME/node_modules/.bin" "$HOME/.config/yarn/global/node_modules/.bin"
  ./node_modules/.bin
  $path
)
export PATH

# Start tmux before expensive interactive setup. Preserve a shell after it exits.
if [[ -o interactive && -t 0 && -t 1 && -z $TMUX && $IS_CRON != true &&
  $TERM_PROGRAM != vscode && $TERM_PROGRAM != Orca ]] && (($+commands[tmux])); then
  command tmux new-session
fi

HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
HISTSIZE=100000
SAVEHIST=100000
DIRSTACKSIZE=100
setopt auto_pushd auto_cd interactive_comments extended_glob \
  hist_ignore_all_dups hist_reduce_blanks print_eight_bit

source "$_zsh_config_root/zshconf/functions.zsh"
source "$_zsh_config_root/zshconf/aliases.zsh"

# Keep machine-specific values and aliases outside the repository.
[[ -r ${ZDOTDIR:-$HOME}/.zshrc.local ]] && source "${ZDOTDIR:-$HOME}/.zshrc.local"
# Local settings may add PATH entries; wrappers and mise must still take precedence.
path=("$HOME/.local/bin" "$HOME/.local/share/mise/shims" $path)

export LS_COLORS='di=01;34:ln=01;35:so=01;32:ex=01;91:bd=44;33:cd=43;34:su=41;30:sg=46;30:tw=42;30:ow=43;30'
export LSCOLORS=gxfxcxdxbxegedabagacag
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' menu select
zstyle ':completion:*:cd:*' ignore-parents parent pwd
zstyle ':completion:*:descriptions' format '%BCompletion%b %U%d%u'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
autoload -Uz compinit
compinit

# EDITOR=nvim otherwise makes zsh choose vi mode.
bindkey -e
bindkey '^f' forward-word
bindkey '^b' backward-word
autoload -Uz edit-command-line select-word-style history-search-end
zle -N edit-command-line
bindkey '^[e' edit-command-line
bindkey '^X^E' edit-command-line
select-word-style default
zstyle ':zle:*' word-chars ' /=;@:{},|'
zstyle ':zle:*' word-style unspecified
zle -N history-beginning-search-backward-end history-search-end
zle -N history-beginning-search-forward-end history-search-end
bindkey '^p' history-beginning-search-backward-end
bindkey '^n' history-beginning-search-forward-end
if (($+commands[peco])); then
  zle -N peco-select-history
  bindkey '^r' peco-select-history
fi

if whence -p git-wt >/dev/null; then
  eval "$(command git-wt --init zsh)"
fi
(($+commands[starship])) && eval "$(command starship init zsh)"

# Highlighting must be loaded after all ZLE widgets have been defined.
if ((!$+functions[_zsh_highlight])); then
  source "$_zsh_config_root/zshconf/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi
unset _zsh_config_root
